# Copie para .env (uso local) ou cadastre na Vercel em Settings > Environment Variables.

# Chave da API da Anthropic (console.anthropic.com). Sem ela, o chat funciona
# no modo automático, com respostas prontas.
ANTHROPIC_API_KEY=

# Opcional: modelo e nível de esforço da assistente.
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low
